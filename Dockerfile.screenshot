# Screenshot consumer service — kaizen-screenshots → GCS.
# No Playwright: this service never touches a browser, so it builds on
# node:slim instead of the Playwright image (PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD
# keeps `npm ci` from pulling browsers the image will never use).
# Spec: docs/specs/workers/spec-service-decomposition.md §8 (P2)

FROM node:20-slim AS builder
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package*.json ./
RUN npm ci
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

# Development stage for docker-compose: full deps (tsx etc.) with Linux-native
# binaries, so host node_modules never has to be copied in.
FROM node:20-slim AS development
WORKDIR /app
ENV NODE_ENV=development
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package*.json ./
RUN npm ci
CMD ["npm", "run", "dev:screenshot"]

FROM node:20-slim AS production
WORKDIR /app
ENV NODE_ENV=production
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
CMD ["node", "dist/services/screenshot/index.js"]
