# Supply-chain posture (S1, spec-research-adoption-2026-11 §S1; the 2026 npm
# worm waves — TanStack, node-gyp, ChainDrop — motivated every line).
#
# Packages younger than 7 days are refused: every 2026 worm wave was caught
# and unpublished within days, so a week of release-age is the cheapest
# effective filter. Known to npm >= 11.10 (ships with Node 24); older npm
# warns about the unknown key and continues.
min-release-age=7d

# Git dependencies are a provenance hole; nothing in this tree uses one.
allow-git=none
